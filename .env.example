DATABASE_URL=postgres://distru:distru@localhost:54329/csv_import

# 0 = deterministic stubs for Jev and the LLM. 1 = real models (needs a key below).
USE_REAL_MODELS=0

# LLM: chat edits like "the Size column is in ounces"; with LLM_STAGE=on also stage 6 and value maps
# LLM_STAGE=on                          # demo: start with the LLM matching step on (off by default); toggle in chat with "llm on" / "llm off", then "rerun"
LLM_PROVIDER=openai                     # openai | openrouter | anthropic
LLM_MODEL=gpt-4o                        # same accuracy as gpt-4o-mini in the eval, 3-5x faster (openrouter: openai/gpt-4o)
# LLM_PRICE_PER_M=2.5,10                # USD per 1M input,output tokens; defaults to list price for known models
# LLM_STRUCTURED_METHOD=functionCalling # functionCalling (default for openai/openrouter) | jsonSchema
# LLM_TIMEOUT_MS=30000
OPENAI_API_KEY=

# Jev (stage 5). typesafe = direct API (console key); openrouter = same model via OpenRouter; llm = chat-model stand-in.
JEV_PROVIDER=typesafe                   # typesafe | openrouter | llm
JEV_MODEL=jev-latest                    # typesafe: jev-latest; openrouter: typesafe/jev-1.14
TYPESAFE_API_KEY=                       # https://console.typesafe.ai/keys
# JEV_TIMEOUT_MS=5000
# JEV_PRICE_PER_M=0.042                 # USD per 1M input tokens (output is free)
# JEV_API_URL=                          # override the endpoint URL

OPENROUTER_API_KEY=                     # only for openrouter providers
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=                      # only for LLM_PROVIDER=anthropic
